# K리그 데이터포탈 기본 URL (SPA라 메뉴 클릭으로 이동, 주소창은 안 바뀜)
KLEAGUE_BASE_URL=https://data.kleague.com/

# 데이터센터 → 부가기록 → 기대득점 → 선수별 기대득점 (쉼표로 구분, 실제 메뉴 텍스트와 다르면 수정)
MENU_CLICK_PATH=데이터센터,부가기록,기대득점,선수별 기대득점

# 구글 서비스 계정 키 파일 경로 (로컬 실행용)
GOOGLE_SERVICE_ACCOUNT_FILE=service-account.json

# 업데이트할 구글시트 ID (URL의 /d/ 다음 부분)
GOOGLE_SHEET_ID=CHANGE_ME

# 데이터를 기록할 시트(탭) 이름 - 없으면 자동 생성됨
GOOGLE_WORKSHEET_NAME=서울이랜드_xG
